---
const year = new Date().getFullYear();
---
<footer class="footer-gradient text-white-50">
  <div class="container px-4 px-lg-5 py-5">
    <div class="row align-items-center g-4 mb-4">
      <div class="col-lg-6">
        <div class="d-flex align-items-center gap-4 flex-wrap">
          <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill text-success fs-4 me-2" aria-hidden="true"></i>
            <span class="text-white-75">Verificación con IA</span>
          </div>
          <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill text-success fs-4 me-2" aria-hidden="true"></i>
            <span class="text-white-75">Conexión SSL segura</span>
          </div>
          <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill text-success fs-4 me-2" aria-hidden="true"></i>
            <span class="text-white-75">Datos alojados en la UE</span>
          </div>
        </div>
      </div>
      <div class="col-lg-6 text-lg-end">
        <div class="d-flex align-items-center justify-content-lg-end gap-3">
          <i class="bi bi-geo-alt-fill text-warning me-1" aria-hidden="true"></i>
          <span class="text-white fw-semibold">España y Portugal</span>
        </div>
      </div>
    </div>

    <hr class="border-secondary border-opacity-25 my-4" />

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-center gap-3">
      <small class="text-white-50">&copy; {year} Abitamo. Todos los derechos reservados.</small>
      <div class="d-flex gap-3">
        <a class="link-light link-underline-opacity-0 link-underline-opacity-100-hover small" href="https://abitamo.com/terms">Términos</a>
        <a class="link-light link-underline-opacity-0 link-underline-opacity-100-hover small" href="https://abitamo.com/privacy">Privacidad</a>
      </div>
    </div>
  </div>
</footer>
