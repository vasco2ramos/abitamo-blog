---
<header>
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom-0 py-3">
    <div class="container-fluid px-3 px-lg-5">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="https://abitamo.com">
        <img src="/blog/images/logo.png" alt="Abitamo" class="me-2" height="28" />
      </a>

      <button
        class="navbar-toggler border-0"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav mx-auto align-items-lg-center">
          <li class="nav-item">
            <a class="nav-link" href="/blog">Blog</a>
          </li>
        </ul>
        <div class="ms-auto d-flex align-items-center">
          <a class="btn btn-outline-primary fw-semibold border-0" href="https://abitamo.com/contact">
            Habla con nosotros
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>
