---
import BaseLayout from './BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { postUrl, blogIndexPath, appUrl, hreflangCode } from '../lib/urls';
import { t, formatDate } from '../lib/i18n';
import { AUTHOR, AUTHOR_URL, PUBLISHER } from '../lib/site';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const {
  title,
  description,
  slug,
  lang,
  pillar,
  publishDate,
  updatedDate,
  sources,
  heroImage,
  heroImageAlt,
  previewImage,
  previewImageAlt,
  canonicalUrl,
  faq,
  hasCustomHero,
  heroTheme,
} = entry.data;

// Side-by-side hero (title/date on one side, the illustration on the
// other) rather than text overlaid on the image as a background -- a long
// title wrapping to 2-3 lines would otherwise collide with the artwork's
// own detail. The section's own background is a flat color/gradient
// (never the post image), keyed off heroTheme:
//   'dark'  -- navy gradient + white text (original site convention)
//   'light' -- soft neutral beige + charcoal text (for a light-background
//              previewImage, e.g. the warm goldenrod family)
const heroSectionBg =
  heroTheme === 'light'
    ? 'var(--color-background-soft-beige)'
    : 'linear-gradient(135deg, var(--brand-navy-dark) 0%, var(--brand-navy-mid) 100%)';
const heroTextClass = heroTheme === 'light' ? 'text-charcoal' : 'text-white';
const heroSubTextClass = heroTheme === 'light' ? 'text-charcoal-75' : 'text-white-75';

const copy = t(lang);
const formattedDate = formatDate(publishDate, lang);
// Only surface "Actualizado" when the revision is a different day.
const showUpdated = Boolean(updatedDate) && updatedDate!.valueOf() !== publishDate.valueOf();
const formattedUpdated = showUpdated ? formatDate(updatedDate!, lang) : null;
const modifiedDate = showUpdated ? updatedDate! : publishDate;
// Posts with no dedicated OG raster (e.g. component-driven pages with no
// single "hero photo") fall back to their on-page preview SVG rather than
// the generic site logo.
const ogImage = heroImage ?? previewImage;

// Sibling translations of this same post share `slug` but differ in `lang`
// (and, now, in URL slug). Only translations that exist and aren't drafts
// get an hreflang alternate.
const allPosts = await getCollection('blog');
const siblings = allPosts.filter((p) => p.data.slug === slug && !p.data.draft);

const hreflangAlternates = siblings.map((p) => ({
  lang: hreflangCode(p.data.lang),
  href: postUrl(Astro.site, p.data),
}));

const defaultSibling = ['es', 'pt', 'en']
  .map((l) => siblings.find((p) => p.data.lang === l))
  .find(Boolean);
if (defaultSibling) {
  hreflangAlternates.push({
    lang: 'x-default',
    href: postUrl(Astro.site, defaultSibling.data),
  });
}

const resolvedCanonical = canonicalUrl ?? postUrl(Astro.site, entry.data);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  dateModified: modifiedDate.toISOString(),
  inLanguage: lang,
  url: resolvedCanonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': resolvedCanonical },
  ...(ogImage ? { image: new URL(ogImage, Astro.site).toString() } : {}),
  author: AUTHOR,
  publisher: PUBLISHER,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Abitamo', item: appUrl(lang) },
    { '@type': 'ListItem', position: 2, name: copy.blog, item: new URL(blogIndexPath(lang), Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: resolvedCanonical },
  ],
};

const faqSchema = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;

const structuredData = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---
<BaseLayout
  lang={lang}
  ogType="article"
  title={`${title} | Abitamo`}
  description={description}
  canonicalUrl={resolvedCanonical}
  ogImage={ogImage}
  hreflangAlternates={hreflangAlternates}
  structuredData={structuredData}
>
  {!hasCustomHero && (
    <section class="py-5" aria-label={title} style={`background: ${heroSectionBg};`}>
      <div class="container py-4">
        <div class="row align-items-center g-4 g-lg-5">
          <div class={`col-lg-7 ${heroTextClass}`}>
            <span class="badge pillar-badge fw-semibold mb-3 d-inline-block">{pillar}</span>
            <h1 class="display-6 fw-bold mb-3">{title}</h1>
            <p class={`${heroSubTextClass} mb-0 small`}>
              {copy.by} <a href={AUTHOR_URL} rel="author noopener" target="_blank" class="text-reset fw-semibold">{AUTHOR.name}</a>
              <span aria-hidden="true"> · </span>
              {copy.published} <time datetime={publishDate.toISOString().slice(0, 10)}>{formattedDate}</time>
              {formattedUpdated && (
                <>
                  <span aria-hidden="true"> · </span>
                  {copy.updated} <time datetime={updatedDate!.toISOString().slice(0, 10)}>{formattedUpdated}</time>
                </>
              )}
            </p>
          </div>
          {previewImage && (
            <div class="col-lg-5">
              <img
                src={previewImage}
                alt={previewImageAlt ?? ''}
                class="img-fluid rounded-4 shadow-lg w-100"
                loading="eager"
              />
            </div>
          )}
        </div>
      </div>
    </section>
  )}
  <article class={hasCustomHero ? '' : 'py-5 bg-white'}>
    <div class={hasCustomHero ? '' : 'container'}>
      <div class={hasCustomHero ? '' : 'row justify-content-center'}>
        <div class={hasCustomHero ? '' : 'col-lg-8 blog-post-body'}>
          <slot />
        </div>
      </div>
    </div>
  </article>
  {hasCustomHero && (
    <section class="py-3 bg-white border-top" aria-label="Byline">
      <div class="container">
        <p class="small text-muted mb-0">
          {copy.by} <a href={AUTHOR_URL} rel="author noopener" target="_blank" class="fw-semibold">{AUTHOR.name}</a>
          <span aria-hidden="true"> · </span>
          {copy.published} <time datetime={publishDate.toISOString().slice(0, 10)}>{formattedDate}</time>
          {formattedUpdated && (
            <>
              <span aria-hidden="true"> · </span>
              {copy.updated} <time datetime={updatedDate!.toISOString().slice(0, 10)}>{formattedUpdated}</time>
            </>
          )}
        </p>
      </div>
    </section>
  )}
  {!hasCustomHero && faq?.length > 0 && (
    <section class="py-4 bg-white border-top" aria-label={copy.faq}>
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <h2 class="h5 fw-bold mb-3">{copy.faq}</h2>
            {faq.map((item) => (
              <details class="mercado-faq-item">
                <summary>{item.question}</summary>
                <div class="mercado-faq-body">{item.answer}</div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
  {sources?.length > 0 && (
    <section class="py-4 bg-white border-top" aria-label={copy.sources}>
      <div class="container">
        <h2 class="h6 text-muted text-uppercase mb-3">{copy.sources}</h2>
        <ul class="small text-muted">
          {sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
