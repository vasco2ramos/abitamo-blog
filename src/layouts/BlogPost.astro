---
import BaseLayout from './BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { postUrl } from '../lib/urls';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const {
  title,
  description,
  slug,
  lang,
  pillar,
  publishDate,
  sources,
  heroImage,
  heroImageAlt,
  previewImage,
  previewImageAlt,
  canonicalUrl,
  faq,
  hasCustomHero,
  heroTheme,
} = entry.data;

// Side-by-side hero (title/date on one side, the illustration on the
// other) rather than text overlaid on the image as a background -- a long
// title wrapping to 2-3 lines would otherwise collide with the artwork's
// own detail. The section's own background is a flat color/gradient
// (never the post image), keyed off heroTheme:
//   'dark'  -- navy gradient + white text (original site convention)
//   'light' -- soft neutral beige + charcoal text (for a light-background
//              previewImage, e.g. the warm goldenrod family)
const heroSectionBg =
  heroTheme === 'light'
    ? 'var(--color-background-soft-beige)'
    : 'linear-gradient(135deg, var(--brand-navy-dark) 0%, var(--brand-navy-mid) 100%)';
const heroTextClass = heroTheme === 'light' ? 'text-charcoal' : 'text-white';
const heroSubTextClass = heroTheme === 'light' ? 'text-charcoal-75' : 'text-white-75';

const dateLocale = { es: 'es-ES', pt: 'pt-PT', en: 'en-GB' }[lang] ?? 'es-ES';
const formattedDate = publishDate.toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
// Posts with no dedicated OG raster (e.g. component-driven pages with no
// single "hero photo") fall back to their on-page preview SVG rather than
// the generic site logo.
const ogImage = heroImage ?? previewImage;

// Sibling translations of this same post share `slug` but differ in `lang`.
const allPosts = await getCollection('blog');
const siblings = allPosts.filter((p) => p.data.slug === slug);

const hreflangAlternates = siblings.map((p) => ({
  lang: p.data.lang,
  href: postUrl(Astro.site, p.data.lang, p.data.slug),
}));

const defaultSibling = ['es', 'pt', 'en']
  .map((l) => siblings.find((p) => p.data.lang === l))
  .find(Boolean);
if (defaultSibling) {
  hreflangAlternates.push({
    lang: 'x-default',
    href: postUrl(Astro.site, defaultSibling.data.lang, defaultSibling.data.slug),
  });
}

const resolvedCanonical = canonicalUrl ?? postUrl(Astro.site, lang, slug);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  inLanguage: lang,
  url: resolvedCanonical,
  ...(ogImage ? { image: new URL(ogImage, Astro.site).toString() } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'Abitamo',
    url: 'https://abitamo.com',
  },
};

const faqSchema = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;

const structuredData = faqSchema ? [articleSchema, faqSchema] : [articleSchema];
---
<BaseLayout
  title={`${title} | Abitamo`}
  description={description}
  canonicalUrl={resolvedCanonical}
  ogImage={ogImage}
  hreflangAlternates={hreflangAlternates}
  structuredData={structuredData}
>
  {!hasCustomHero && (
    <section class="py-5" aria-label={title} style={`background: ${heroSectionBg};`}>
      <div class="container py-4">
        <div class="row align-items-center g-4 g-lg-5">
          <div class={`col-lg-7 ${heroTextClass}`}>
            <span class="badge pillar-badge fw-semibold mb-3 d-inline-block">{pillar}</span>
            <h1 class="display-6 fw-bold mb-3">{title}</h1>
            <p class={`${heroSubTextClass} mb-0`}>
              <time datetime={publishDate.toISOString()}>{formattedDate}</time>
            </p>
          </div>
          {previewImage && (
            <div class="col-lg-5">
              <img
                src={previewImage}
                alt={previewImageAlt ?? ''}
                class="img-fluid rounded-4 shadow-lg w-100"
                loading="eager"
              />
            </div>
          )}
        </div>
      </div>
    </section>
  )}
  <article class={hasCustomHero ? '' : 'py-5 bg-white'}>
    <div class={hasCustomHero ? '' : 'container'}>
      <div class={hasCustomHero ? '' : 'row justify-content-center'}>
        <div class={hasCustomHero ? '' : 'col-lg-8 blog-post-body'}>
          <slot />
        </div>
      </div>
    </div>
  </article>
  {!hasCustomHero && faq?.length > 0 && (
    <section class="py-4 bg-white border-top" aria-label="Preguntas frecuentes">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <h2 class="h5 fw-bold mb-3">Preguntas frecuentes</h2>
            {faq.map((item) => (
              <details class="mercado-faq-item">
                <summary>{item.question}</summary>
                <div class="mercado-faq-body">{item.answer}</div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
  {sources?.length > 0 && (
    <section class="py-4 bg-white border-top" aria-label="Fuentes">
      <div class="container">
        <h2 class="h6 text-muted text-uppercase mb-3">Fuentes</h2>
        <ul class="small text-muted">
          {sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
