@@ -19,6 +19,14 @@
   # Generated from config/public_pages.yml
   get 'sitemap.xml', to: 'sitemaps#show', defaults: { format: 'xml' }, as: :sitemap
 
+  # Blog: a static site on Cloudflare, relayed by BlogProxyController. Declared before the
+  # locale scope so `/es/blog` is not treated as an app page. `format: false` keeps file
+  # extensions (.xml, .png, .css) inside the path.
+  get ':locale/blog(/*blog_path)', to: 'blog_proxy#show', locale: /es|pt|en/, format: false
+  get 'blog-assets/*blog_path', to: 'blog_proxy#show', format: false
+  get 'blog-sitemap-index.xml', to: 'blog_proxy#show', format: false
+  get 'blog-sitemap-:number.xml', to: 'blog_proxy#show', number: /\d+/, format: false
+
   # Catch invalid paths before locale scope
   get '*invalid', to: 'errors#not_found', constraints: lambda { |req|
     req.path.start_with?('/.')
diff -ruN a/test/controllers/blog_proxy_controller_test.rb b/test/controllers/blog_proxy_controller_test.rb
--- a/test/controllers/blog_proxy_controller_test.rb	1970-01-01 01:00:00
+++ b/test/controllers/blog_proxy_controller_test.rb	2026-10-28 14:59:10
@@ -0,0 +1,112 @@
+# frozen_string_literal: true
+
+require 'test_helper'
+
+class BlogProxyControllerTest < ActionDispatch::IntegrationTest
+  ORIGIN = 'https://blog-origin.abitamo.com'
+
+  def upstream(code: 200, body: '<html>post</html>', headers: { 'content-type' => 'text/html; charset=utf-8' })
+    stub(code: code, body: body, headers: headers)
+  end
+
+  # Rails reorders Cache-Control directives, so compare them as a set.
+  def cache_directives
+    response.headers['Cache-Control'].split(',').map(&:strip).sort
+  end
+
+  test 'relays a blog page from the origin, keeping the path and query' do
+    HTTParty.expects(:get).with("#{ORIGIN}/pt/blog/mercado-arrendamento-2026?utm_source=x",
+                                has_entries(follow_redirects: false, format: :plain)).returns(upstream)
+
+    get '/pt/blog/mercado-arrendamento-2026?utm_source=x'
+
+    assert_response :success
+    assert_equal '<html>post</html>', response.body
+    assert_match %r{text/html}, response.content_type
+    assert_equal %w[max-age=300 public], cache_directives
+  end
+
+  test 'serves the listing for every blog locale' do
+    %w[es pt en].each do |locale|
+      HTTParty.expects(:get).with("#{ORIGIN}/#{locale}/blog", anything).returns(upstream)
+      get "/#{locale}/blog"
+      assert_response :success
+    end
+  end
+
+  test 'does not set a session cookie, so responses stay cacheable' do
+    HTTParty.stubs(:get).returns(upstream)
+
+    get '/es/blog'
+
+    assert_nil response.headers['Set-Cookie']
+  end
+
+  test 'hashed build assets are cached for a year, other assets for a day' do
+    HTTParty.expects(:get).with("#{ORIGIN}/blog-assets/_astro/Base.abc123.css", anything)
+            .returns(upstream(headers: { 'content-type' => 'text/css' }))
+    HTTParty.expects(:get).with("#{ORIGIN}/blog-assets/images/logo.png", anything)
+            .returns(upstream(headers: { 'content-type' => 'image/png' }))
+
+    get '/blog-assets/_astro/Base.abc123.css'
+    assert_equal %w[immutable max-age=31536000 public], cache_directives
+
+    get '/blog-assets/images/logo.png'
+    assert_equal %w[max-age=86400 public], cache_directives
+  end
+
+  test 'relays the blog sitemap files with their extension intact' do
+    HTTParty.expects(:get).with("#{ORIGIN}/blog-sitemap-index.xml", anything)
+            .returns(upstream(headers: { 'content-type' => 'application/xml' }))
+    HTTParty.expects(:get).with("#{ORIGIN}/blog-sitemap-0.xml", anything)
+            .returns(upstream(headers: { 'content-type' => 'application/xml' }))
+
+    get '/blog-sitemap-index.xml'
+    assert_response :success
+    get '/blog-sitemap-0.xml'
+    assert_response :success
+  end
+
+  test 'passes upstream 404s through without long caching' do
+    HTTParty.expects(:get).returns(upstream(code: 404, body: 'Not found', headers: { 'content-type' => 'text/plain' }))
+
+    get '/en/blog/nope'
+
+    assert_response :not_found
+    assert_equal 'no-store', response.headers['Cache-Control']
+  end
+
+  test 'rewrites upstream redirects to this host' do
+    HTTParty.expects(:get).returns(upstream(code: 307, body: '', headers: { 'location' => "#{ORIGIN}/es/blog" }))
+
+    get '/es/blog/'
+
+    assert_response :temporary_redirect
+    assert_redirected_to '/es/blog'
+  end
+
+  test 'answers 502 when the origin is unreachable' do
+    HTTParty.expects(:get).raises(Net::OpenTimeout)
+
+    get '/es/blog'
+
+    assert_response :bad_gateway
+    assert_equal 'no-store', response.headers['Cache-Control']
+  end
+
+  test 'answers 502 when the origin itself fails' do
+    HTTParty.expects(:get).returns(upstream(code: 503, body: 'down', headers: {}))
+
+    get '/es/blog'
+
+    assert_response :bad_gateway
+  end
+
+  test 'does not proxy locales the app does not have' do
+    HTTParty.expects(:get).never
+
+    get '/fr/blog'
+
+    assert_response :not_found
+  end
+end
