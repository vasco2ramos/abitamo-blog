diff -ruN a/app/controllers/blog_proxy_controller.rb b/app/controllers/blog_proxy_controller.rb
--- a/app/controllers/blog_proxy_controller.rb	1970-01-01 01:00:00
+++ b/app/controllers/blog_proxy_controller.rb	2026-10-28 14:59:26
@@ -0,0 +1,84 @@
+# frozen_string_literal: true
+
+# Serves the blog under this host (abitamo.com/{es,pt,en}/blog). The blog is a static site on
+# a Cloudflare Worker, reachable at BLOG_ORIGIN. A Cloudflare Worker route on abitamo.com
+# cannot do this job: the apex is proxied to Render, which sits behind its own Cloudflare
+# network, so zone Workers never run for it. Rails relays the request instead.
+#
+# Inherits from ActionController::Base on purpose: no locale handling, auth or flash, and no
+# session cookie, so the responses stay cacheable.
+class BlogProxyController < ActionController::Base # rubocop:disable Rails/ApplicationController
+  ORIGIN = ENV.fetch('BLOG_ORIGIN_URL', 'https://blog-origin.abitamo.com').chomp('/')
+  OPEN_TIMEOUT = 2
+  READ_TIMEOUT = 8
+
+  PAGE_CACHE = 'public, max-age=300'
+  ASSET_CACHE = 'public, max-age=86400'
+  HASHED_ASSET_CACHE = 'public, max-age=31536000, immutable'
+  ERROR_CACHE = 'no-store'
+
+  UPSTREAM_ERRORS = [
+    HTTParty::Error, Net::OpenTimeout, Net::ReadTimeout, SocketError, SystemCallError, OpenSSL::SSL::SSLError
+  ].freeze
+
+  before_action { request.session_options[:skip] = true }
+
+  def show
+    upstream = fetch_upstream
+    status = upstream.code.to_i
+
+    if (300..399).cover?(status) && upstream.headers['location'].present?
+      relay_redirect(upstream, status)
+    else
+      relay_body(upstream, status)
+    end
+  rescue *UPSTREAM_ERRORS => e
+    Rails.logger.error("[blog_proxy] #{request.fullpath}: #{e.class}: #{e.message}")
+    upstream_failed
+  end
+
+  private
+
+  # Upstream redirects (e.g. trailing slash) carry the origin hostname; keep visitors on this host.
+  def relay_redirect(upstream, status)
+    target = URI.parse(upstream.headers['location'])
+    path = target.path.presence || '/'
+    path = "#{path}?#{target.query}" if target.query
+    response.headers['Cache-Control'] = PAGE_CACHE
+    redirect_to path, status: status
+  end
+
+  def fetch_upstream
+    HTTParty.get("#{ORIGIN}#{request.fullpath}", format: :plain, follow_redirects: false,
+                                                 open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT)
+  end
+
+  def relay_body(upstream, status)
+    return upstream_failed if status >= 500
+
+    response.headers['Cache-Control'] = cache_control_for(status)
+    copy_validators(upstream)
+    render body: upstream.body, status: status,
+           content_type: upstream.headers['content-type'].presence || 'application/octet-stream'
+  end
+
+  def copy_validators(upstream)
+    { 'etag' => 'ETag', 'last-modified' => 'Last-Modified' }.each do |from, to|
+      value = upstream.headers[from]
+      response.headers[to] = value if value.present?
+    end
+  end
+
+  def upstream_failed
+    response.headers['Cache-Control'] = ERROR_CACHE
+    head :bad_gateway
+  end
+
+  def cache_control_for(status)
+    return ERROR_CACHE unless status == 200
+    return HASHED_ASSET_CACHE if request.path.start_with?('/blog-assets/_astro/')
+    return ASSET_CACHE if request.path.start_with?('/blog-assets/')
+
+    PAGE_CACHE
+  end
+end
diff -ruN a/config/routes.rb b/config/routes.rb
--- a/config/routes.rb	2026-10-28 14:58:32
