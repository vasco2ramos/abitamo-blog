diff -ruN a/app/services/blog_links.rb b/app/services/blog_links.rb
--- a/app/services/blog_links.rb	1970-01-01 01:00:00
+++ b/app/services/blog_links.rb	2026-10-28 14:20:22
@@ -0,0 +1,23 @@
+# The blog is served by a Cloudflare Worker from abitamo.com/{locale}/blog
+# (blog repo: wrangler.toml). Article slugs are translated per locale; the
+# keys here are the Spanish slugs, which the blog also uses as the shared
+# translation key (`slug` in its frontmatter).
+module BlogLinks
+  ARTICLE_SLUGS = {
+    'certificado-inquilino' => { es: 'certificado-inquilino', pt: 'certificado-de-inquilino', en: 'tenant-certificate' },
+    'mercado' => { es: 'mercado', pt: 'mercado-arrendamento-2026', en: 'rental-market-2026' },
+    'decretos-vivienda-octubre-2026' => {
+      es: 'decretos-vivienda-octubre-2026',
+      pt: 'decretos-habitacao-outubro-2026',
+      en: 'spain-housing-decrees-october-2026'
+    }
+  }.freeze
+
+  def self.index_path(locale)
+    "/#{locale}/blog"
+  end
+
+  def self.article_path(key, locale)
+    "#{index_path(locale)}/#{ARTICLE_SLUGS.fetch(key).fetch(locale.to_sym)}"
+  end
+end
